# ==============================================================================
# Road-Sathi Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting development:
#   cp .env.example .env
# NOTE: Never commit sensitive credentials or real secrets to source control.
# ==============================================================================

# Global Environment
NODE_ENV=development

# ------------------------------------------------------------------------------
# Core Backend API (services/api)
# ------------------------------------------------------------------------------
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Database (Future setup - PostgreSQL / MongoDB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/road_sathi_dev

# Authentication & Security (Future setup)
JWT_SECRET=your_jwt_secret_key_placeholder_min_32_chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_placeholder
REFRESH_TOKEN_EXPIRES_IN=30d

# Redis / Cache (Future setup)
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# AI Microservice (services/ai)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=5001
AI_SERVICE_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# Frontend Applications
# ------------------------------------------------------------------------------
# Web Client (apps/web)
VITE_WEB_PORT=3000
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Provider Client (apps/provider)
VITE_PROVIDER_PORT=3001
VITE_PROVIDER_API_BASE_URL=http://localhost:5000/api/v1

# Admin Client (apps/admin)
VITE_ADMIN_PORT=3002
VITE_ADMIN_API_BASE_URL=http://localhost:5000/api/v1
